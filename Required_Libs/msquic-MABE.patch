+static inline void
+CxPlatNormalizeSockaddrForSyscall(_Inout_ QUIC_ADDR* A)
+{
+    // Gramine dumps syscall args by interpreting sockaddr buffers.
+    // Ensure sa_family matches Linux values before any syscall.
+
+    if (A->Ip.sa_family == QUIC_ADDRESS_FAMILY_INET6) {
+        A->Ipv6.sin6_family = AF_INET6;
+    } else if (A->Ip.sa_family == QUIC_ADDRESS_FAMILY_INET) {
+        A->Ipv4.sin_family = AF_INET;
+    } else if (A->Ip.sa_family == AF_INET6 || A->Ip.sa_family == AF_INET) {
+        // already normalized
+    } else {
+        // Defensive: default to AF_INET6 if MsQuic left it in an internal value.
+        A->Ipv6.sin6_family = AF_INET6;
+    }
+}
